{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "outDir": "dist",
    "baseUrl": ".",
    "types": ["react", "react-dom", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@maku/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@maku/ui": ["../../packages/ui/src/index.ts"],
      "@maku/utils": ["../../packages/utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts", "../../packages/ui/src/**/*", "../../packages/utils/src/**/*", "../../packages/shared-types/src/**/*"],
  "exclude": ["node_modules", "dist"]
}

# ─── web-app (Management System) ────────────────────────────────────────────
# Copy to .env.local for development

# API base URL — in dev this is proxied via Vite (see vite.config.ts)
# In production this is the full API subdomain URL
VITE_API_URL=https://api.maku.trendscore.co.ke/v1

# Public website URL (for "Back to website" links)
VITE_PUBLIC_URL=https://maku.trendscore.co.ke

# App URL (this app's own URL — used in emails/links)
VITE_APP_URL=https://app.maku.trendscore.co.ke

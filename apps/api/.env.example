# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# URLs (used for CORS)
FRONTEND_PUBLIC_URL=http://localhost:5173
FRONTEND_APP_URL=http://localhost:5174
API_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maku_db
DB_USER=maku_user
DB_PASS=changeme_strong_password
DB_LOGGING=false

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_with_another_64_byte_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=maku_redis_pass

# ─── MinIO (S3-compatible storage) ──────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=maku_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_BUCKET_MEMBERS=maku-members
MINIO_BUCKET_DOCUMENTS=maku-documents

# ─── SMS (Africa's Talking) ─────────────────────────────────────────────────
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=MAKU

# ─── Email (SendGrid) ───────────────────────────────────────────────────────
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@maku.coop
EMAIL_FROM_NAME=MAKU Cooperative

# ─── M-Pesa (Daraja API) ────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_ENV=sandbox

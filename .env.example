# ─── Root .env — shared by Docker Compose ───────────────────────────────────
# Copy to .env and fill in values before running docker compose

# Database
DB_NAME=maku_db
DB_USER=maku_user
DB_PASS=changeme_strong_password

# Redis
REDIS_PASS=changeme_redis_password

# MinIO
MINIO_ROOT_USER=maku_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
